{
  "schemaVersion": 1,
  "id": "vrgear",
  "version": "${version}",
  "name": "VR Gear",
  "description": "This mod applies Quest 2 headset and controllers models to your player model, just for visuals",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/vr-gear",
    "sources": "https://github.com/Suff99/VRModel"
  },
  "license": "https://github.com/Suff99/VRModel/blob/main/LICENSE",
  "icon": "vr_gear.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.vrgear.fabric.VRGearModFabric"
    ],
    "client": [
      "net.vrgear.fabric.VRGearModFabricClient"
    ]
  },
  "mixins": [
    "vrgear.mixins.json",
    "vrgear.common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.155.2",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
